# Agentic Council Environment Configuration

# LLM API Keys (Required)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Optional: OpenAI API Key (for fallback)
OPENAI_API_KEY=your-openai-api-key-here

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Dashboard Configuration
DASHBOARD_PORT=8501
API_URL=http://localhost:8000

# Database (Optional - for persistence)
DATABASE_URL=sqlite:///./data/council.db
REDIS_URL=redis://localhost:6379

# Council Configuration
COUNCIL_TOTAL_TIME=900
COUNCIL_PHASE1_TIME=300
COUNCIL_PHASE2_TIME=420
COUNCIL_PHASE3_TIME=180
COUNCIL_RISK_APPETITE=moderate
ENABLE_DEVILS_ADVOCATE=true

# RAG Configuration
RAG_COLLECTION_NAME=case_studies
RAG_TOP_K=5
